      ],
      "source": [
        "df1 = df.select_dtypes(include=['int64', 'float64']).columns\n",
        "Q1 = df[df1].quantile(0.25)\n",
        "Q3 = df[df1].quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "lower_bound = Q1 - 1.5 * IQR\n",
        "upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "# Đếm số lượng outlier cho từng cột\n",
        "outlier_count = ((df[df1] < lower_bound) | (df[df1] > upper_bound)).sum()\n",
        "\n",
        "# Tạo df3 gộp các cột kết quả lại\n",
        "df3 = pd.DataFrame({\n",
        "    'Q1': Q1,\n",
        "    'Q3': Q3,\n",
        "    'IQR': IQR,\n",
        "    'lower_bound': lower_bound,\n",
        "    'upper_bound': upper_bound,\n",
        "    'outlier_count': outlier_count\n",
        "})\n",
        "\n",
        "print(df3)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 48,
      "id": "28815d77",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "(40155, 16)\n",
            "(50000, 16)\n"
          ]
        }
      ],
      "source": [
        "# Xử lý outlier bằng 2 cách: IQR và clip\n",
        "# df4 cho IQR (0.5 đ)\n",
        "df4 = df.copy()\n",
        "q1 = df4.quantile(0.25, numeric_only= True)\n",
        "q3 = df4.quantile(0.75, numeric_only=True)\n",
        "iqr = q3 - q1\n",
        "numeric_cols = q1.index\n",
        "df4 = df4[~((df4[numeric_cols] < (q1 - 1.5*iqr)) | (df4[numeric_cols] > (q3 + 1.5*iqr))).any(axis=1)]\n",
        "df4\n",
        "# df4 = df4[\n",
        "#     ~((df4[numeric_cols] < (q1 - 1.5 * iqr))\n",
        "#         | (df4[numeric_cols] > (q3 + 1.5 * iqr))\n",
        "#     ).any(axis=1)\n",
        "# ]\n",
        "# df5 cho clip (0.5 đ)\n",
        "# df5 = df.copy()\n",
        "# df5?\n",
        "df5 = df.copy()\n",
        "# Q1 = df5.quantile(0.25, numeric_only=True)\n",
        "# Q3 = df5.quantile(0.75, numeric_only=True)\n",
        "# IQR = Q3 - Q1 \n",
        "# upper = Q3 + 1.5 * IQR\n",
        "# lower = Q1 - 1.5 *IQR\n",
        "# df5 = df5.clip(upper,lower, axis=1)\n",
        "for col in numeric_cols:\n",
        "  lower_bound = Q1[col] - 1.5 * IQR[col]\n",
        "  upper_bound = Q3[col] + 1.5 * IQR[col]\n",
        "  df5[col] = df5[col].clip(lower=lower_bound, upper=upper_bound)\n",
        "\n",
        "print(df4.shape)\n",
        "print(df5.shape)\n"
      ]
    },
