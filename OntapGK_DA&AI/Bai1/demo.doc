          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "# nếu lệch, hãy tính lại cột original_price sao cho phân phối của nó gần với phân phối chuẩn nhất (gợi ý dùng log) (0.25 đ)\n",
        "# log(0) = -inf nên chỉ lấy log giá > 0\n",
        "# df5['original_price'] = np.log(?.where(? > 0))\n",
        "df5['original_price'] = np.log(df5['original_price'].where(df5['original_price'] > 0))\n",
        "# vẽ histogram cho cột original_price sau khi log\n",
        "# ??\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.hist(df['original_price'].dropna(), bins=30, edgecolor='black')\n",
        "plt.title('Phân phối' )\n",
        "plt.xlabel('Label X')\n",
        "plt.ylabel('Tần số')\n",
        "plt.show()"
      ]
    },
