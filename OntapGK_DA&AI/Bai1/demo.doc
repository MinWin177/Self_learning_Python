      "source": [
        "df2 = pd.DataFrame({\n",
        "    'column_name': df.columns,\n",
        "    'missing_count': df.isnull().sum().values,\n",
        "    'missing_percentage': (df.isnull().sum() / len(df) * 100).values\n",
        "})\n",
        "df2"
      ]
    },
