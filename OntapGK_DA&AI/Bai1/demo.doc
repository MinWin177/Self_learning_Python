      "source": [
        "df['Age'] = df['Age'].fillna(df['Age'].median())\n",
        "df = df.dropna(subset=['Age'])\n",
        "# description: ?\n",
        "df['description'] = df['description'].fillna('Unknown')\n",
        "# kiểm tra lại sau xử lý missing data\n",
        "df.isnull().sum()"
      ]
