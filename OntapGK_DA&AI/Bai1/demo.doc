      "source": [
        "# cho biết skew, kurtosis, mean, median của cột original_price (0.5)\n",
        "skew_val = df['original_price'].skew()\n",
        "kurtosis = df['original_price'].kurtosis()\n",
        "mean = df['original_price'].mean()\n",
        "median = df['original_price'].median()\n",
        "print(skew_val)\n",
        "print(kurtosis)\n",
        "print(mean)\n",
        "print(median)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 21,
      "id": "9822915c",
      "metadata": {},
      "outputs": [],
      "source": [
        "# cho biết original_price có lệch không (lệch trái, lệch phải, đối xứng) ?  (0.25 đ)\n",
        "# làm sao để biết cụ thể trên độ đo nào? \n",
        "# ?"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 22,
      "id": "2c647d83",
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1. original_price có lệch không? (Lệch trái, lệch phải, đối xứng?)\n",
        "# Trả lời: Dữ liệu về giá (original_price) thường có xu hướng bị lệch phải (Right-skewed / Positive skew).\n",
        "\n",
        "# Lý do: Do phần lớn các dòng xe có mức giá phổ thông, nhưng có một số ít dòng xe siêu sang hoặc giá cực cao nằm ở đuôi bên phải kéo phân phối lệch đi.\n",
        "\n",
        "# 2. Làm sao để biết cụ thể trên độ đo nào?\n",
        "# Bạn có thể xác định thông qua 2 độ đo chính:\n",
        "\n",
        "# Hệ số Skewness (Độ lệch): Dựa vào kết quả của hàm df['original_price'].skew():\n",
        "\n",
        "# Nếu Skew > 0: Lệch phải (đuôi dài về phía giá trị lớn).\n",
        "\n",
        "# Nếu Skew < 0: Lệch trái (đuôi dài về phía giá trị nhỏ).\n",
        "\n",
        "# Nếu Skew = 0 (hoặc xấp xỉ 0): Phân phối đối xứng.\n",
        "\n",
        "# So sánh giá trị Mean và Median:\n",
        "\n",
        "# Nếu Mean > Median: Khẳng định dữ liệu lệch phải (vì giá trị trung bình bị kéo lệch lên cao bởi các giá trị ngoại lai lớn).\n",
        "\n",
        "# Nếu Mean < Median: Dữ liệu lệch trái.\n",
        "\n",
        "#  Nếu Mean ≈ Median: Phân phối đối xứng."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 54,
      "id": "be8393c0",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 800x500 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "# vẽ histogram cột original_price (0.25 đ)\n",
        "# ?\n",
        "# plt.figure(figsize=(8,3))\n",
        "# sns.histplot(\"original_price\")\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.hist(df['original_price'].dropna(), bins=30, edgecolor='black')\n",
        "plt.title('Phân phối' )\n",
        "plt.xlabel('Label X')\n",
        "plt.ylabel('Tần số')\n",
        "plt.show()\n",
        "\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 56,
      "id": "256b972d",
      "metadata": {},
      "outputs": [
        {
          "data": {
