        "# Tạo bảng tổng hợp\n",
        "#cách 1 DataFrame\n",
        "df_missing = pd.DataFrame(\n",
        "    {'Số lượng thiếu': missing_count, 'Tỷ lệ (%)': missing_percentage}\n",
        ")\n",
        "print(df_missing[df_missing['Số lượng thiếu'] > 0])\n",
        "#Cách 2 Concat\n",
        "df2 = pd.concat([df_missing, missing_percentage], axis = 1)\n",
        "df2"
      ]
    },
